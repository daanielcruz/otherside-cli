{
  "name": "otherside",
  "version": "0.9.1-pre",
  "description": "Multi-provider coding agent CLI.",
  "type": "module",
  "private": true,
  "bin": {
    "otherside": "./dist/otherside"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build:native": "bun run scripts/build-native-audio.ts",
    "build": "bun run build:native && bun build --compile --target=bun-darwin-arm64 --define 'process.env.NODE_ENV=\"production\"' --outfile=dist/otherside src/main.ts && (codesign --remove-signature dist/otherside 2>/dev/null || true) && codesign -s - dist/otherside",
    "build:install": "bun run build && cp dist/otherside $HOME/.local/bin/otherside",
    "build:win": "bun run scripts/build-native-audio.ts x86_64-pc-windows-msvc && cp vendor/rg/x86_64-pc-windows-msvc/rg.bin src/engine/tools/_infra/embedded/rg.bin && cp vendor/ugrep/x86_64-pc-windows-msvc/ugrep.bin src/engine/tools/_infra/embedded/ugrep.bin && (bun build --compile --target=bun-windows-x64 --define 'process.env.NODE_ENV=\"production\"' --outfile=dist/otherside.exe src/main.ts; r=$?; git checkout -- src/engine/tools/_infra/embedded/rg.bin src/engine/tools/_infra/embedded/ugrep.bin; exit $r)",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/bun": "^1.3.14",
    "@types/diff": "^8.0.0",
    "@types/execa": "^2.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.14",
    "@types/react-reconciler": "^0.33.0",
    "@types/scheduler": "^0.26.0",
    "@types/semver": "^7.7.1",
    "@types/signal-exit": "^3.0.0",
    "@types/stack-utils": "^2.0.3",
    "@types/ws": "^8.18.1",
    "ajv-formats": "^3.0.1",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.3.0",
    "@anthropic-ai/sdk": "^0.105.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "ajv": "^8.20.0",
    "ansi-escapes": "^7.3.0",
    "ansi-styles": "^6.2.3",
    "auto-bind": "^5.0.1",
    "axios": "^1.18.0",
    "bidi-js": "^1.0.3",
    "bun-types": "canary",
    "chalk": "^5.6.2",
    "cli-boxes": "^4.0.1",
    "cli-cursor": "^4.0.0",
    "cli-truncate": "^6.0.0",
    "code-excerpt": "^4.0.0",
    "diff": "^9.0.0",
    "emoji-regex": "^10.6.0",
    "es-toolkit": "^1.45.1",
    "execa": "^9.6.1",
    "get-east-asian-width": "^1.5.0",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^9.0.0",
    "indent-string": "^5.0.0",
    "is-in-ci": "^2.0.0",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.2",
    "patch-console": "^2.0.0",
    "pngjs": "^7.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.5",
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0",
    "semver": "^7.8.4",
    "signal-exit": "^4",
    "slice-ansi": "^9.0.0",
    "socket.io-client": "^4.8.3",
    "stack-utils": "^2.0.6",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.4.0",
    "terminal-size": "^4.0.1",
    "type-fest": "^5.5.0",
    "usehooks-ts": "^3.1.1",
    "werift": "0.23.0",
    "widest-line": "^6.0.0",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.20.0",
    "yoga-layout": "~3.2.1",
    "zod": "^4.4.3"
  }
}
